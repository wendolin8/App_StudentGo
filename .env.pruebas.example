# Copia este archivo a .env.pruebas.local (el archivo local está excluido de Git).
# Obtén estos valores solo desde el proyecto Supabase student-go-pruebas.
STUDENT_GO_TEST_PROJECT_REF=YOUR_TEST_PROJECT_REF
VITE_SUPABASE_URL=https://YOUR_TEST_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_TEST_PUBLISHABLE_KEY

# Configurar como secreto de Supabase Edge Functions; no se usa desde Vite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
